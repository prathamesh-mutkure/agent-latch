# Copy to .env at the repo root. Apps load this file when it exists.
# Do not commit .env.

# API
PORT=3001
API_URL=http://localhost:3001

# Background agent
AGENT_NAME=trader
AGENT_INTERVAL_MS=10000
AGENT_POLL_MS=2000

# Local Postgres from docker compose.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentlatch

# Ethereum Sepolia (chain id 11155111). One chain for the whole demo.
# SEPOLIA_RPC_URL=
# Circle USDC, 6 decimals. Policy amounts are this token, shown as dollars.
# USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Demo signer. Sepolia test key only. The executor reads this. Policy never signs.
# EXECUTOR_PRIVATE_KEY=

# Phase 4 — ENSv2
# ENS_REGISTRY_ADDRESS=

# Phase 5 — World ID for Agents
# WORLD_APP_ID=
# WORLD_ACTION=

# Phase 6 — Intercepta and x402 on Ethereum Sepolia
# INTERCEPTA_API_KEY=
# X402_NETWORK=eip155:11155111
