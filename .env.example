# Copy to .env at the repo root. Apps load this file when it exists.
# Do not commit .env.

# API
PORT=3001
API_URL=http://localhost:3001
# Signs owner sessions. API only, never VITE_. Generate with `openssl rand -hex 32`.
# Unset, every sign-in ends when the API restarts.
# SESSION_SECRET=

# Background agent and the MCP server. Both idle (or refuse) without these.
# Copy them from the agent's page. The key is shown once.
# AGENT_ID=
# AGENT_KEY=
AGENT_INTERVAL_MS=10000
AGENT_POLL_MS=2000
# MCP server (apps/mcp) pays as this agent, else AGENT_ID above.
# AGENTLATCH_AGENT_ID=

# Local Postgres from docker compose.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentlatch

# ENS parent namespace. Agent labels are registered under this name.
ENS_PARENT_NAME=agent-latch.eth
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Parent registry. Defaults to the Sepolia ETHRegistry.
# ENS_REGISTRY_ADDRESS=0x657ea849311d3d5823348dded7c2aaafb3ede09e
# Circle USDC, 6 decimals. Policy amounts are this token, shown as dollars.
# USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Demo signer. Sepolia test key only. The executor reads this. Policy never signs.
# EXECUTOR_PRIVATE_KEY=

# Phase 4 — ENSv2
# ENS_REGISTRY_ADDRESS=

# Phases 5 and 8 — World App mini app. Owners sign in and approve in World App.
# Create the mini app in the Developer Portal, enable notifications, and set its URL to
# the public web host. The API key is secret: API only, never VITE_.
# WORLD_APP_ID=
# WORLD_NOTIFICATION_API_KEY=
# World Chain RPC for Safe (EIP-1271) signature checks. Defaults to the public endpoint.
# WORLDCHAIN_RPC_URL=
# World ID for Agents: fresh human check on every approve (device grant, RFC 8628).
# Confidential client from https://sandbox.auth.world.org/portal, client_secret_basic.
# The secret is API only, never VITE_. Without these, approve returns 503.
# WORLD_OIDC_ISSUER=https://sandbox.auth.world.org
# WORLD_CLIENT_ID=
# WORLD_CLIENT_SECRET=

# Phase 6 — Intercepta quick scan before an X402_PAYMENT. Header X-API-KEY.
# A missing key refuses the payment. It does not invent an allow.
# INTERCEPTA_API_KEY=
# X402_NETWORK=eip155:11155111
# Payee for GET /x402/resource. Defaults to the demo signer, which self-transfers.
# The facilitator settles only to this address.
# X402_PAY_TO=
# x402 facilitator for the demo seller. Broadcasts settlements and pays Sepolia gas.
# Defaults to EXECUTOR_PRIVATE_KEY. Sepolia test key only.
# FACILITATOR_PRIVATE_KEY=
# Where the demo seller reaches the facilitator. Defaults to this API.
# FACILITATOR_URL=http://localhost:3001/facilitator
