# Copy to .env at the repo root. Apps load this file when it exists.
# Do not commit .env.
#
# The web app has no environment. It calls /api on its own host.
# No VITE_ variable. Secrets stay on the API, the background agent, or the MCP server.

# ---------------------------------------------------------------------------
# API (apps/api). One process. Railway sets PORT; locally it is 3001.
# ---------------------------------------------------------------------------

PORT=3001

# Signs owner sessions. Generate once with `openssl rand -hex 32` and keep it.
# Unset, every API restart signs everyone out.
# SESSION_SECRET=

# Local Postgres from docker compose. On Neon, use the direct string
# (host without -pooler). Drop channel_binding if Neon adds it.
# Do not set DATABASE_URL_POOLED. The API does not read it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentlatch

# Chain. Sepolia.
ENS_PARENT_NAME=agent-latch.eth
# Public node rate-limits ENS reads. Set a keyed URL when you have one.
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Defaults to the Sepolia ETHRegistry.
# ENS_REGISTRY_ADDRESS=0x657ea849311d3d5823348dded7c2aaafb3ede09e
# World Chain RPC for Safe (EIP-1271) checks. Defaults to the public endpoint.
# WORLDCHAIN_RPC_URL=
# Sepolia test key. The executor reads this. Policy never signs.
# EXECUTOR_PRIVATE_KEY=

# World App. API only.
# WORLD_APP_ID=
# WORLD_NOTIFICATION_API_KEY=
# World ID for Agents. Confidential client, client_secret_basic.
# Without the three below, approve returns 503.
# WORLD_OIDC_ISSUER=https://sandbox.auth.world.org
# WORLD_CLIENT_ID=
# WORLD_CLIENT_SECRET=

# x402 demo seller and facilitator.
# INTERCEPTA_API_KEY=
X402_PAY_TO=0x142B99367b928608835501633534411EFc467737
# Local API. On Railway, leave this unset so the seller uses http://localhost:$PORT/facilitator.
FACILITATOR_URL=http://localhost:3001/facilitator
# FACILITATOR_PRIVATE_KEY= (unset: falls back to EXECUTOR_PRIVATE_KEY)

# ---------------------------------------------------------------------------
# Background agent (apps/agent) and MCP (apps/mcp). Not read by the API.
# ---------------------------------------------------------------------------

API_URL=http://localhost:3001

# Copy from the agent's page. The key is shown once. Without both, the agent idles.
# AGENT_ID=
# AGENT_KEY=
AGENT_INTERVAL_MS=10000
AGENT_POLL_MS=2000

# MCP only. Pays as AGENTLATCH_AGENT_ID, else AGENT_ID.
# AGENT_PRIVATE_KEY is required once the agent was created with an authAddress.
# AGENTLATCH_AGENT_ID=
# AGENT_PRIVATE_KEY=
# AGENTLATCH_AGENT_ENS=
