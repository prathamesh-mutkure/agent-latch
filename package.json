{
  "name": "agentlatch",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.8",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "bun --filter @agentlatch/api db:generate",
    "db:migrate": "bun --filter @agentlatch/api db:migrate",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait && bun run db:migrate"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/integrations/*"
  ]
}
